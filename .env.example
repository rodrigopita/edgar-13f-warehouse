# Copy to .env and fill in. Astro injects every line into the Airflow containers
# on `astro dev start`; edit, then `astro dev restart` for changes to take effect.

# The client builds the User-Agent as the project name plus this address
AIRFLOW_VAR_EDGAR_CONTACT=<your-email>

# S3 bucket for the raw zone, one you own. Airflow reads it as a Variable.
AIRFLOW_VAR_RAW_BUCKET=<your-bucket-name>

# Pipeline IAM user. login is the access key id, password the secret.
AIRFLOW_CONN_AWS_DEFAULT={"conn_type": "aws", "login": "<key-id>", "password": "<secret>", "extra": {"region_name": "<bucket-region>"}}

# Snowflake service user AIRFLOW_SVC, key-pair login, role LOADER. Build this line
# from the key, not by hand: uv run python -I scripts/snowflake_conn_line.py <key.p8> >> .env
# The key goes in base64 under private_key_content and its passphrase in password,
# which the Snowflake hook uses to decrypt it.
AIRFLOW_CONN_SNOWFLAKE_DEFAULT={"conn_type": "snowflake", "login": "AIRFLOW_SVC", "password": "<key-passphrase>", "extra": {"account": "<organization>-<account>", "authenticator": "SNOWFLAKE_JWT", "role": "LOADER", "warehouse": "EDGAR_WH", "database": "EDGAR_13F", "private_key_content": "<base64 of the encrypted .p8>"}}
